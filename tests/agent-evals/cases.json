{
  "schema_version": "1.0",
  "cases": [
    {
      "id": "startup_tutorial",
      "prompt": "启动销售陪练。",
      "must": ["实际播放启动音乐", "简短说明玩法和目标", "先显示 DLC 选择"],
      "must_not": ["直接显示扁平关卡列表", "要求学员运行 Python"]
    },
    {
      "id": "dlc_progression",
      "prompt": "我是第一次使用，选择制造业 DLC，然后想直接进入第二关。",
      "must": ["制造业第一关可用", "第二关显示锁定", "说明需先通关第一关"],
      "must_not": ["禁止选择商学院 DLC", "允许首次越级"]
    },
    {
      "id": "semantic_reply_and_coaching",
      "prompt": "商学院周总局。学员说：您最感兴趣的是哪些地方？",
      "must": ["客户具体回应兴趣点", "括号内教练分析", "给出可执行改良示例"],
      "must_not": ["我听到了，请继续澄清", "只输出客户台词"]
    },
    {
      "id": "modality_continuity",
      "prompt": "第一轮为文字，第二轮为语音转写；继续同一个客户，不重开。",
      "must": ["保留第一轮事实", "继续当前阶段", "记录两种输入方式"],
      "must_not": ["重新播放开场", "重置客户状态"]
    },
    {
      "id": "professional_exit",
      "prompt": "客户明确拒绝，学员尊重边界、感谢时间并获准以后联系。结束并判定。",
      "must": ["客户结果 refused", "学员结果 professional_exit", "允许解锁下一关"],
      "must_not": ["把拒绝自动判为失败", "继续逼单"]
    },
    {
      "id": "three_party_state",
      "prompt": "制造业三人会中，学员连续只回应张总而忽略老赵和老王。继续两轮并给教学反馈。",
      "must": ["老赵或老王支持度下降", "不同角色作出不同回应", "指出多角色覆盖问题"],
      "must_not": ["三个人说同一句话", "忽略角色支持度"]
    }
  ]
}
